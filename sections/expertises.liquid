{%- comment -%}
  Expertises Section - Showcases the 4 main expertise categories
  With Phosphor icons and mouse-follow glow effect
  - Electricity
  - Home Automation (Domotique)
  - Solar (Solaire)
  - Security (Sécurité)
{%- endcomment -%}

{% liquid
  assign current_expertise = section.settings.current_expertise
%}

{%- comment -%} Phosphor Icons CDN {%- endcomment -%}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css" media="print" onload="this.media='all'" />
<noscript>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css" />
</noscript>

<expertises-section
  id="Expertises-{{ section.id }}"
  class="expertises-section color-{{ section.settings.color_scheme }}"
>
  <div class="expertises__container section {{ section.settings.section_width }}">
    {% if section.settings.show_title %}
      <div class="expertises__header">
        <h2 class="expertises__title">{{ section.settings.title | default: 'Nos Expertises' }}</h2>
        {% if section.settings.subtitle != blank %}
          <p class="expertises__subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="expertises__grid">
      {%- comment -%} Electricity {%- endcomment -%}
      <a href="{{ section.settings.electricity_link | default: '/pages/electricite' }}"
         class="expertises__card{% if current_expertise == 'electricity' %} expertises__card--active{% endif %}"
         data-mouse-effect>
        <div class="expertises__card-glow"></div>
        <div class="expertises__card-inner">
          <div class="expertises__card-icon">
            <i class="ph ph-lightning"></i>
          </div>
          <div class="expertises__card-content">
            <span class="expertises__card-hero">{{ section.settings.electricity_hero | default: 'Énergie maîtrisée' }}</span>
            <h3 class="expertises__card-title">{{ section.settings.electricity_title | default: 'Électricité' }}</h3>
            <p class="expertises__card-description">{{ section.settings.electricity_description | default: 'Installation et maintenance électrique professionnelle' }}</p>
            <span class="expertises__card-link">
              Découvrir
              <i class="ph ph-arrow-right"></i>
            </span>
          </div>
        </div>
      </a>

      {%- comment -%} Home Automation (Domotique) {%- endcomment -%}
      <a href="{{ section.settings.domotique_link | default: '/pages/domotique' }}"
         class="expertises__card{% if current_expertise == 'domotique' %} expertises__card--active{% endif %}"
         data-mouse-effect>
        <div class="expertises__card-glow"></div>
        <div class="expertises__card-inner">
          <div class="expertises__card-icon">
            <i class="ph ph-cpu"></i>
          </div>
          <div class="expertises__card-content">
            <span class="expertises__card-hero">{{ section.settings.domotique_hero | default: 'Habitat intelligent' }}</span>
            <h3 class="expertises__card-title">{{ section.settings.domotique_title | default: 'Domotique' }}</h3>
            <p class="expertises__card-description">{{ section.settings.domotique_description | default: 'Maison connectée et automatisation intelligente' }}</p>
            <span class="expertises__card-link">
              Découvrir
              <i class="ph ph-arrow-right"></i>
            </span>
          </div>
        </div>
      </a>

      {%- comment -%} Solar (Solaire) {%- endcomment -%}
      <a href="{{ section.settings.solaire_link | default: '/pages/solaire' }}"
         class="expertises__card{% if current_expertise == 'solaire' %} expertises__card--active{% endif %}"
         data-mouse-effect>
        <div class="expertises__card-glow"></div>
        <div class="expertises__card-inner">
          <div class="expertises__card-icon">
            <i class="ph ph-sun"></i>
          </div>
          <div class="expertises__card-content">
            <span class="expertises__card-hero">{{ section.settings.solaire_hero | default: 'Puissance naturelle' }}</span>
            <h3 class="expertises__card-title">{{ section.settings.solaire_title | default: 'Solaire' }}</h3>
            <p class="expertises__card-description">{{ section.settings.solaire_description | default: 'Solutions photovoltaïques durables' }}</p>
            <span class="expertises__card-link">
              Découvrir
              <i class="ph ph-arrow-right"></i>
            </span>
          </div>
        </div>
      </a>

      {%- comment -%} Security (Sécurité) {%- endcomment -%}
      <a href="{{ section.settings.securite_link | default: '/pages/securite' }}"
         class="expertises__card{% if current_expertise == 'securite' %} expertises__card--active{% endif %}"
         data-mouse-effect>
        <div class="expertises__card-glow"></div>
        <div class="expertises__card-inner">
          <div class="expertises__card-icon">
            <i class="ph ph-shield-check"></i>
          </div>
          <div class="expertises__card-content">
            <span class="expertises__card-hero">{{ section.settings.securite_hero | default: 'Protection totale' }}</span>
            <h3 class="expertises__card-title">{{ section.settings.securite_title | default: 'Sécurité' }}</h3>
            <p class="expertises__card-description">{{ section.settings.securite_description | default: 'Systèmes de surveillance et protection' }}</p>
            <span class="expertises__card-link">
              Découvrir
              <i class="ph ph-arrow-right"></i>
            </span>
          </div>
        </div>
      </a>
    </div>
  </div>
</expertises-section>

{% stylesheet %}
  .expertises-section {
    padding: var(--padding-xl) 0;
  }

  .expertises__container {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xl);
  }

  .expertises__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .expertises__title {
    font-family: var(--font-primary--family);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 600;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }

  .expertises__subtitle {
    font-size: var(--font-size--body-md);
    opacity: 0.7;
    margin: 0;
  }

  .expertises__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--gap-md);
  }

  /* Card Base */
  .expertises__card {
    --mouse-x: 50%;
    --mouse-y: 50%;
    display: block;
    position: relative;
    background: rgb(var(--color-background-rgb));
    border: 1px solid rgb(var(--color-border-rgb) / 0.08);
    border-radius: 16px;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
  }

  .expertises__card:hover,
  .expertises__card--active {
    border-color: rgb(var(--color-foreground-rgb) / 0.15);
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgb(0 0 0 / 0.06);
  }

  .expertises__card--active {
    border-color: rgb(var(--color-foreground-rgb) / 0.2);
  }

  /* Mouse-follow glow effect */
  .expertises__card-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      500px circle at var(--mouse-x) var(--mouse-y),
      rgb(var(--color-foreground-rgb) / 0.07),
      transparent 40%
    );
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
    z-index: 1;
    will-change: opacity;
  }

  .expertises__card:hover .expertises__card-glow {
    opacity: 1;
  }

  /* Card Inner Container */
  .expertises__card-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: var(--padding-lg);
    height: 100%;
  }

  /* Phosphor Icon */
  .expertises__card-icon {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--gap-lg);
    color: var(--color-foreground);
    background: rgb(var(--color-foreground-rgb) / 0.04);
    border-radius: 14px;
    transition: background 0.3s ease, transform 0.3s ease;
  }

  .expertises__card-icon i {
    font-size: 28px;
    line-height: 1;
  }

  .expertises__card:hover .expertises__card-icon {
    background: rgb(var(--color-foreground-rgb) / 0.08);
    transform: scale(1.05);
  }

  /* Hero Text */
  .expertises__card-hero {
    display: block;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    opacity: 0.5;
    margin-bottom: 0.375rem;
    transition: opacity 0.3s ease;
  }

  .expertises__card:hover .expertises__card-hero {
    opacity: 0.7;
  }

  /* Card Content */
  .expertises__card-content {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .expertises__card-title {
    font-family: var(--font-primary--family);
    font-size: 1.375rem;
    font-weight: 600;
    margin: 0 0 0.625rem;
    letter-spacing: -0.02em;
  }

  .expertises__card-description {
    font-size: var(--font-size--body-sm);
    opacity: 0.6;
    margin: 0 0 var(--gap-lg);
    line-height: 1.6;
    flex-grow: 1;
  }

  .expertises__card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--font-size--body-sm);
    font-weight: 500;
    opacity: 0.6;
    transition: opacity 0.25s ease, gap 0.25s ease;
  }

  .expertises__card-link i {
    font-size: 16px;
    transition: transform 0.25s ease;
  }

  .expertises__card:hover .expertises__card-link {
    opacity: 1;
  }

  .expertises__card:hover .expertises__card-link i {
    transform: translateX(4px);
  }

  /* Tablet - 2 columns */
  @media screen and (max-width: 990px) {
    .expertises__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Mobile - 1 column with compact cards */
  @media screen and (max-width: 749px) {
    .expertises-section {
      padding: var(--padding-lg) 0;
    }

    .expertises__container {
      gap: var(--gap-lg);
      padding: 0 var(--padding-md);
    }

    .expertises__header {
      text-align: left;
    }

    .expertises__grid {
      grid-template-columns: 1fr;
      gap: var(--gap-sm);
    }

    .expertises__card {
      border-radius: 12px;
    }

    .expertises__card:hover,
    .expertises__card--active {
      transform: translateX(4px);
    }

    .expertises__card-inner {
      flex-direction: row;
      align-items: center;
      padding: var(--padding-md);
      gap: var(--gap-md);
    }

    .expertises__card-icon {
      width: 52px;
      height: 52px;
      min-width: 52px;
      margin-bottom: 0;
      border-radius: 12px;
    }

    .expertises__card-icon i {
      font-size: 24px;
    }

    .expertises__card-content {
      flex: 1;
      min-width: 0;
    }

    .expertises__card-hero {
      font-size: 0.625rem;
      margin-bottom: 0.125rem;
    }

    .expertises__card-title {
      font-size: 1rem;
      margin-bottom: 0.125rem;
    }

    .expertises__card-description {
      font-size: 0.8125rem;
      opacity: 0.55;
      margin-bottom: 0;
      display: -webkit-box;
      -webkit-line-clamp: 1;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .expertises__card-link {
      display: none;
    }

    .expertises__title {
      font-size: 1.5rem;
    }

    /* Disable glow on mobile for performance */
    .expertises__card-glow {
      display: none;
    }
  }

  /* Accessibility - Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .expertises__card,
    .expertises__card-glow,
    .expertises__card-icon,
    .expertises__card-hero,
    .expertises__card-link,
    .expertises__card-link i {
      transition: none;
    }

    .expertises__card:hover,
    .expertises__card--active {
      transform: none;
    }

    .expertises__card-glow {
      display: none;
    }
  }
{% endstylesheet %}

<script>
  class ExpertisesSection extends HTMLElement {
    constructor() {
      super();
      this.lastTime = 0;
      this.frameDelay = 16; // ~60fps throttle
    }

    connectedCallback() {
      // Check for reduced motion preference
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        return;
      }

      this.boundHandleMouseMove = this.handleMouseMove.bind(this);
      this.boundHandleMouseLeave = this.handleMouseLeave.bind(this);

      this.addEventListener('mousemove', this.boundHandleMouseMove);
      this.addEventListener('mouseleave', this.boundHandleMouseLeave);
    }

    disconnectedCallback() {
      this.removeEventListener('mousemove', this.boundHandleMouseMove);
      this.removeEventListener('mouseleave', this.boundHandleMouseLeave);
    }

    handleMouseMove(e) {
      const now = Date.now();
      if (now - this.lastTime < this.frameDelay) return;
      this.lastTime = now;

      const card = e.target.closest('[data-mouse-effect]');
      if (!card) return;

      const rect = card.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * 100;
      const y = ((e.clientY - rect.top) / rect.height) * 100;

      card.style.setProperty('--mouse-x', `${x}%`);
      card.style.setProperty('--mouse-y', `${y}%`);
    }

    handleMouseLeave(e) {
      const card = e.target.closest('[data-mouse-effect]');
      if (card) {
        card.style.setProperty('--mouse-x', '50%');
        card.style.setProperty('--mouse-y', '50%');
      }
    }
  }

  if (!customElements.get('expertises-section')) {
    customElements.define('expertises-section', ExpertisesSection);
  }
</script>

