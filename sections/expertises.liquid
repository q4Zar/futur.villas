        { "value": "solaire", "label": "Solaire" },
        { "value": "securite", "label": "Sécurité" }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Électricité"
    },
    {
      "type": "text",
      "id": "electricity_title",
      "label": "Title",
      "default": "Électricité"
    },
    {
      "type": "text",
      "id": "electricity_description",
      "label": "Description",
      "default": "Installation et maintenance électrique professionnelle"
    },
    {
      "type": "url",
      "id": "electricity_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Domotique"
    },
    {
      "type": "text",
      "id": "domotique_title",
      "label": "Title",
      "default": "Domotique"
    },
    {
      "type": "text",
      "id": "domotique_description",
      "label": "Description",
      "default": "Maison connectée et automatisation intelligente"
    },
    {
      "type": "url",
      "id": "domotique_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Solaire"
    },
    {
      "type": "text",
      "id": "solaire_title",
      "label": "Title",
      "default": "Solaire"
    },
    {
      "type": "text",
      "id": "solaire_description",
      "label": "Description",
      "default": "Solutions photovoltaïques durables"
    },
    {
      "type": "url",
      "id": "solaire_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Sécurité"
    },
    {
      "type": "text",
      "id": "securite_title",
      "label": "Title",
      "default": "Sécurité"
    },
    {
      "type": "text",
      "id": "securite_description",
      "label": "Description",
      "default": "Systèmes de surveillance et protection"
    },
    {
      "type": "url",
      "id": "securite_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Expertises",
      "category": "Content"
    }
  ]
}
